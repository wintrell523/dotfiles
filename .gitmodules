[submodule "dotbot"]
	path = dotbot
	url = https://github.com/anishathalye/dotbot
	ignore = dirty
[submodule "dotbot-brewfile"]
	path = dotbot-plugins/dotbot-brewfile
	url = https://github.com/sobolevn/dotbot-brewfile.git
[submodule "dotbot-vscode"]
	path = dotbot-plugins/dotbot-vscode
	url = https://github.com/hujianxin/dotbot-vscode
