{"name":"wintrell","settings":"{\"settings\":\"{\\n  \\\"editor.suggestSelection\\\": \\\"first\\\",\\n  \\\"editor.fontFamily\\\": \\\"'fira code'\\\",\\n  \\\"editor.fontSize\\\": 14,\\n  \\\"editor.formatOnSave\\\": true,\\n  \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  \\\"gitProjectManager.baseProjectsFolders\\\": [\\\"~/Projects/\\\", \\\"~/work_projects/\\\"],\\n  \\\"[json]\\\": {\\n    \\\"editor.quickSuggestions\\\": {\\n      \\\"strings\\\": true\\n    },\\n    \\\"editor.suggest.insertMode\\\": \\\"replace\\\",\\n    \\\"gitlens.codeLens.scopes\\\": [\\\"document\\\"]\\n  },\\n  \\\"gitlens.defaultTimeFormat\\\": \\\"HH:mm\\\",\\n  \\\"gitlens.defaultDateShortFormat\\\": \\\"DD.MM.YY\\\",\\n  \\\"gitlens.defaultDateFormat\\\": \\\"DD.MM.YYYY HH:mm\\\",\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"workbench.iconTheme\\\": \\\"Monokai Pro (Filter Octagon) Icons\\\",\\n  \\\"window.title\\\": \\\"${dirty}${activeEditorShort}${separator}${rootPath}${separator}${appName}\\\",\\n  \\\"workbench.editor.highlightModifiedTabs\\\": true,\\n  \\\"[git-commit]\\\": { \\\"editor.rulers\\\": [40] },\\n  \\\"[javascript]\\\": { \\\"editor.rulers\\\": [80] },\\n  \\\"[typescript]\\\": { \\\"editor.rulers\\\": [80] },\\n  \\\"[python]\\\": {\\n    \\\"editor.rulers\\\": [79, 120],\\n    \\\"editor.formatOnType\\\": true\\n  },\\n  \\\"editor.rulers\\\": [120],\\n  \\\"workbench.editorAssociations\\\": {\\n    \\\"*.ipynb\\\": \\\"jupyter.notebook.ipynb\\\",\\n    \\\"git-rebase-todo\\\": \\\"gitlens.rebase\\\"\\n  },\\n  \\\"python.languageServer\\\": \\\"Default\\\",\\n  \\\"terminal.external.osxExec\\\": \\\"iTerm2.app\\\",\\n  \\\"terminal.integrated.fontFamily\\\": \\\"MesloLGS NF\\\",\\n  \\\"todo-tree.general.tags\\\": [\\n    \\\"BUG\\\",\\n    \\\"HACK\\\",\\n    \\\"FIXME\\\",\\n    \\\"TODO\\\",\\n    \\\"XXX\\\",\\n    \\\"[ ]\\\",\\n    \\\"[x]\\\"\\n  ],\\n  \\\"todo-tree.regex.regex\\\": \\\"(//|#|<!--|;|/\\\\\\\\*|^|^\\\\\\\\s*(-|\\\\\\\\d+.))\\\\\\\\s*($TAGS)\\\",\\n  \\\"files.associations\\\": {\\n    \\\"*.html\\\": \\\"html\\\"\\n  },\\n  \\\"json.schemas\\\": [\\n    {\\n      \\\"fileMatch\\\": [\\\"cypress.json\\\"],\\n      \\\"url\\\": \\\"https://on.cypress.io/cypress.schema.json\\\"\\n    }\\n  ],\\n  \\\"redhat.telemetry.enabled\\\": false,\\n  \\\"cypressHelper.commandForOpen\\\": \\\"yarn cy:open:dev\\\",\\n  \\\"cypressHelper.commandForRun\\\": \\\"yarn cy:run:dev\\\",\\n  \\\"cypressHelper.menuItems\\\": {\\n    \\\"OpenCypress\\\": false,\\n    \\\"RunCypress\\\": true,\\n    \\\"GenerateCustomCommandTypes\\\": false,\\n    \\\"GoToCustomCommand\\\": false,\\n    \\\"FindCustomCommandReferences\\\": false,\\n    \\\"FindStepDefinitionReferences\\\": false,\\n    \\\"SchemaGenerator\\\": false,\\n    \\\"ParseHAR\\\": false,\\n    \\\"mockAutocomplete\\\": false\\n  },\\n  \\\"terminal.explorerKind\\\": \\\"external\\\",\\n  \\\"editor.foldingStrategy\\\": \\\"indentation\\\",\\n  \\\"sync.gist\\\": \\\"4c85860fb1ed970a22fcb42d32760dce\\\",\\n  \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n  \\\"editor.cursorBlinking\\\": \\\"expand\\\",\\n  \\\"terminal.integrated.cursorBlinking\\\": true,\\n  \\\"terminal.integrated.cursorStyle\\\": \\\"underline\\\",\\n  \\\"typescript.inlayHints.parameterNames.enabled\\\": \\\"literals\\\",\\n  \\\"typescript.suggest.paths\\\": true,\\n  \\\"javascript.suggest.paths\\\": true,\\n  \\\"workbench.productIconTheme\\\": \\\"el-vsc-v1-icons\\\",\\n  \\\"editor.bracketPairColorization.enabled\\\": true,\\n  \\\"json.maxItemsComputed\\\": 10000,\\n  \\\"faker.locale\\\": \\\"cz\\\",\\n  \\\"workbench.editor.enablePreview\\\": false,\\n  \\\"vsicons.dontShowNewVersionMessage\\\": true,\\n  \\\"workbench.colorTheme\\\": \\\"Plastic - deprioritised punctuation\\\",\\n  \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\n  \\\"debug.javascript.autoAttachFilter\\\": \\\"onlyWithFlag\\\",\\n  \\\"editor.unicodeHighlight.nonBasicASCII\\\": false\\n}\\n\"}","snippets":"{\"snippets\":{\"bat.json\":\"{\\n\\t// Place your snippets for bat here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n}\",\"cypress_snippets.code-snippets\":\"{\\n  // Place your global snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and\\n  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope\\n  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is\\n  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.\\n  // Placeholders with the same ids are connected.\\n  // Example:\\n  // \\\"Print to console\\\": {\\n  // \\t\\\"scope\\\": \\\"javascript,typescript\\\",\\n  // \\t\\\"prefix\\\": \\\"log\\\",\\n  // \\t\\\"body\\\": [\\n  // \\t\\t\\\"console.log('$1');\\\",\\n  // \\t\\t\\\"$2\\\"\\n  // \\t],\\n  // \\t\\\"description\\\": \\\"Log output to console\\\"\\n  // }\\n  \\\"Get data-cy tag\\\": {\\n    \\\"scope\\\": \\\"javascript,typescript\\\",\\n    \\\"prefix\\\": \\\"cyg\\\",\\n    \\\"body\\\": \\\"cy.getCy('$1')${0:;}\\\",\\n    \\\"description\\\": \\\"Get element by data-cy tag\\\"\\n  },\\n  \\\"It async\\\": {\\n    \\\"scope\\\": \\\"javascript,typescript\\\",\\n    \\\"prefix\\\": \\\"ita\\\",\\n    \\\"body\\\": \\\"it('$1', async () => {$0});\\\"\\n  }\\n}\\n\"}}","extensions":"[{\"identifier\":{\"id\":\"aaron-bond.better-comments\",\"uuid\":\"7a0110bb-231a-4598-aa1b-0769ea46d28b\"},\"displayName\":\"Better Comments\"},{\"identifier\":{\"id\":\"albert.tabout\",\"uuid\":\"4ef6c2d5-de36-45a1-9015-18c1d4a3a25e\"},\"displayName\":\"TabOut\"},{\"identifier\":{\"id\":\"andrew-codes.cypress-snippets\",\"uuid\":\"0db1f6a4-4b91-4615-b105-20c7e6191ecd\"},\"displayName\":\"Cypress Snippets\"},{\"identifier\":{\"id\":\"attilabuti.mustache-syntax-vscode\",\"uuid\":\"39745952-aa3c-497d-9d03-e0d1164eb7dc\"},\"displayName\":\"Mustache Syntax\"},{\"identifier\":{\"id\":\"codezombiech.gitignore\",\"uuid\":\"3e891cf9-53cb-49a3-8d01-8f0b1f0afb29\"},\"displayName\":\"gitignore\"},{\"identifier\":{\"id\":\"dakara.dakara-foldplus\",\"uuid\":\"0929f405-649c-41ac-b39f-2352e3d65a77\"},\"displayName\":\"Fold Plus\"},{\"identifier\":{\"id\":\"dbaeumer.vscode-eslint\",\"uuid\":\"583b2b34-2c1e-4634-8c0b-0b82e283ea3a\"},\"displayName\":\"ESLint\"},{\"identifier\":{\"id\":\"deerawan.vscode-faker\",\"uuid\":\"0808d236-6faf-4f68-9f17-28f51a572ee4\"},\"displayName\":\"vscode-faker\"},{\"identifier\":{\"id\":\"donjayamanne.python-environment-manager\",\"uuid\":\"0c9f60fd-5588-42f7-9176-e80c3ae111ec\"},\"displayName\":\"Python Environment Manager\"},{\"identifier\":{\"id\":\"donjayamanne.python-extension-pack\",\"uuid\":\"f5188937-53e0-45bb-a16d-61231003fa3b\"},\"displayName\":\"Python Extension Pack\"},{\"identifier\":{\"id\":\"dsznajder.es7-react-js-snippets\",\"uuid\":\"19804510-b475-4dae-b0f7-6ca08fd1af0c\"},\"displayName\":\"ES7+ React/Redux/React-Native snippets\"},{\"identifier\":{\"id\":\"eamodio.gitlens\",\"uuid\":\"4de763bd-505d-4978-9575-2b7696ecf94e\"},\"displayName\":\"GitLens — Git supercharged\"},{\"identifier\":{\"id\":\"editorconfig.editorconfig\",\"uuid\":\"f60a60a6-95ba-42d4-b41c-3d24c