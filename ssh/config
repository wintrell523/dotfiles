# Global config
Host *
	UseKeychain yes
	AddKeysToAgent yes
	IdentityFile ~/.ssh/id_ed25519

# HomeCredit GitLab
Host git.homecredit.net
	Preferredauthentications publickey
	IdentityFile ~/.ssh/hc_ext

# HomeCredit app servers
Host *.infra
	Preferredauthentications publickey
	IdentityFile ~/.ssh/hc_jmeter_key.pem

# Carvago GitLab
Host gitlab.eag.guru
	Preferredauthentications publickey
	AddKeysToAgent yes
	UseKeychain yes
	IdentityFile ~/.ssh/carvago
