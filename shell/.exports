# Shell exports consolidated from dotfiles

# Dotfiles directory
export DOTFILES="$HOME/.dotfiles"

# PGP config
# because of https://github.com/keybase/keybase-issues/issues/2798
export GPG_TTY=$(tty)

# Editor
export EDITOR=vim

# PATH exports
export PATH="$HOME/.local/bin:$PATH"
eval "$(/opt/homebrew/bin/brew shellenv)"; export PATH="$(/opt/homebrew/bin/brew --prefix grep)/libexec/gnubin:$PATH"
eval "$(mise activate zsh)"

# Node.js options
export NODE_OPTIONS="--max-old-space-size=4096"


# Typecheck GO
export TYPECHECK_GO_BIN=tsrs

# GPG default recipient for encryption (falls back to git user.email)
# export GPG_DEFAULT_RECIPIENT="your-email@example.com"